# ==========================================================
# AI-Powered Personal Finance Tracker Configuration
# ==========================================================

# Server Environment
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Secret Key for JWT Authentication and Session Security
JWT_SECRET=super-secret-finance-jwt-token-key-2026-secure
JWT_EXPIRATION_HOURS=24

# Database Connection (MySQL / MariaDB or SQLite fallback)
# MySQL Format: mysql+pymysql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/finance_tracker_db

# Frontend URL (For CORS allowlist)
FRONTEND_URL=http://localhost:5173
